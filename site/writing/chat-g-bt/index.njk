---
layout: layouts/base.njk
title: "Chat G B.T. - The Original Chat G"
description: "Original posts from B.T. Franklin on technology, creativity, work, and whatever else needs to be said."
navKey: writing
---
<main class="flex-grow">
    <div class="container mx-auto px-4 pt-10 pb-16">
        <section class="overflow-hidden rounded-xl border border-cyan-300/70 bg-gray-950 shadow-2xl dark:border-cyan-800/70"
            aria-labelledby="chat-g-bt-title">
            <div{% if features.chatGBTVideo %}
                class="grid lg:grid-cols-[minmax(18rem,0.75fr)_minmax(0,1.25fr)] lg:items-stretch"{% endif %}>
                <header
                    class="relative isolate flex flex-col justify-center overflow-hidden bg-gradient-to-br from-cyan-950 via-gray-950 to-violet-950 p-7 md:p-10 lg:p-12">
                    <div class="absolute -left-20 -top-20 -z-10 size-64 rounded-full bg-cyan-400/20 blur-3xl"
                        aria-hidden="true"></div>
                    <div class="absolute -bottom-24 -right-20 -z-10 size-72 rounded-full bg-violet-500/25 blur-3xl"
                        aria-hidden="true"></div>
                    <h1 id="chat-g-bt-title" class="font-mono text-4xl font-bold leading-none text-white md:text-6xl">
                        Chat G B.T.
                    </h1>
                    <p class="mt-3 font-mono text-sm font-semibold text-cyan-300">
                        The Original Chat G
                    </p>
                    <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-300">
                        Original posts from B.T. Franklin on technology, creativity, work, and whatever else needs to be
                        said.
                    </p>
                </header>

                {% if features.chatGBTVideo %}
                <div class="relative bg-black">
                    <video data-chat-g-bt-banner controls muted loop playsinline preload="metadata"
                        aria-describedby="chat-g-bt-transcript"
                        class="aspect-video h-full w-full object-cover">
                        <source src="/writing/chat-g-bt/videos/chatg-bt-horizontal-1.mp4" type="video/mp4">
                        <p>
                            Your browser cannot play this video.
                            <a href="/writing/chat-g-bt/videos/chatg-bt-horizontal-1.mp4">Open the Chat G B.T. video</a>.
                        </p>
                    </video>
                    <button data-chat-g-bt-audio-toggle type="button" hidden aria-pressed="false"
                        class="absolute bottom-4 right-4 z-10 flex size-12 items-center justify-center rounded-full border border-white/50 bg-black/75 text-white shadow-lg backdrop-blur-sm transition hover:bg-black/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
                        title="Turn sound on">
                        <svg data-chat-g-bt-muted-icon aria-hidden="true" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="size-6">
                            <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
                            <path d="m22 9-6 6"></path>
                            <path d="m16 9 6 6"></path>
                        </svg>
                        <svg data-chat-g-bt-audible-icon aria-hidden="true" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="size-6" hidden>
                            <path d="M11 5 6 9H2v6h4l5 4V5Z"></path>
                            <path d="M15.5 8.5a5 5 0 0 1 0 7"></path>
                            <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
                        </svg>
                        <span data-chat-g-bt-audio-label class="sr-only">Turn sound on</span>
                    </button>
                    <p id="chat-g-bt-transcript" class="sr-only">
                        Video transcript: They call me Chat G B.T., the Original Chat G. Hell yeah. Only real G's roll
                        with me!
                    </p>
                </div>
                {% endif %}
            </div>
        </section>

        <section class="mt-14" aria-labelledby="posts-heading">
            <div class="mb-7 flex flex-col gap-2 border-b border-zinc-300 pb-5 dark:border-zinc-700 md:flex-row md:items-end md:justify-between">
                <div>
                    <h2 id="posts-heading" class="font-mono text-3xl font-bold text-zinc-950 dark:text-white">
                        Posts
                    </h2>
                </div>
                {% if collections.chatGBTPosts.length %}
                <p class="font-mono text-sm text-zinc-500 dark:text-zinc-400">
                    {{ collections.chatGBTPosts.length }} post{% if collections.chatGBTPosts.length != 1 %}s{% endif %}
                </p>
                {% endif %}
            </div>

            {% if collections.chatGBTPosts.length %}
            <div class="grid gap-6 md:grid-cols-2">
                {% for post in collections.chatGBTPosts %}
                <a href="{{ post.url }}"
                    class="group flex h-full flex-col rounded-lg border border-cyan-300/60 bg-white/85 p-6 shadow-lg backdrop-blur-sm transition-all duration-200 hover:-translate-y-1 hover:border-cyan-400 hover:shadow-2xl dark:border-cyan-800/70 dark:bg-cyan-950/25 md:p-8">
                    {% if post.date %}
                    <time class="font-mono text-sm text-zinc-500 dark:text-zinc-400"
                        datetime="{{ post.date.toISOString() }}">{{ post.date | displayDate }}</time>
                    {% endif %}
                    <h3
                        class="mt-3 font-mono text-2xl font-bold text-zinc-950 transition-colors group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-200">
                        {{ post.data.title }}
                    </h3>
                    {% if post.data.description %}
                    <p class="mt-4 grow text-zinc-700 dark:text-zinc-300 leading-relaxed">
                        {{ post.data.description }}
                    </p>
                    {% endif %}
                    <span class="mt-6 font-mono text-sm font-bold text-cyan-700 dark:text-cyan-300">Read post →</span>
                </a>
                {% endfor %}
            </div>
            {% else %}
            <div class="rounded-lg border border-dashed border-cyan-400/60 bg-cyan-50/70 p-8 text-center dark:border-cyan-800 dark:bg-cyan-950/20 md:p-12">
                <p class="font-mono text-xl font-bold text-zinc-900 dark:text-zinc-100">The first post is on the way.</p>
                <p class="mx-auto mt-3 max-w-xl text-zinc-600 dark:text-zinc-400">
                    The booth is open. The Original Chat G is getting the first transmission ready.
                </p>
            </div>
            {% endif %}
        </section>
    </div>
</main>

{% if features.chatGBTVideo %}
<script defer src="/chat-g-bt.js"></script>
{% endif %}
