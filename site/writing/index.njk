---
layout: layouts/base.njk
title: "Writing - B.T. Franklin"
description: "Chat G B.T. posts and longer-form articles on software architecture, technology, and creative work by B.T. Franklin."
navKey: writing
---
<main class="flex-grow">
    <div class="container mx-auto px-4 pt-10 pb-12">
        <h1 class="text-3xl font-bold mb-8 font-mono text-zinc-800 dark:text-zinc-100 flex items-center">
            <span class="border-b-4 border-cyan-500 pb-2">Writing</span>
        </h1>

        <p class="mb-8 max-w-3xl text-zinc-600 dark:text-zinc-300 leading-relaxed">
            The home of Chat G B.T. and longer-form articles on software architecture, technology, and creative work.
        </p>

        <section aria-labelledby="chat-g-bt-heading">
            <a href="/writing/chat-g-bt/"
                class="group relative isolate block overflow-hidden rounded-lg border border-cyan-300/70 bg-gradient-to-br from-cyan-50/95 via-white/90 to-violet-100/90 p-6 shadow-xl transition-all duration-200 hover:-translate-y-1 hover:shadow-2xl dark:border-cyan-700/60 dark:from-cyan-950/80 dark:via-gray-950/90 dark:to-violet-950/80 md:p-8">
                <div class="absolute -right-16 -top-20 -z-10 size-64 rounded-full bg-cyan-400/20 blur-3xl"
                    aria-hidden="true"></div>
                <div class="absolute -bottom-24 left-1/3 -z-10 size-64 rounded-full bg-violet-500/20 blur-3xl"
                    aria-hidden="true"></div>
                <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
                    <div>
                        <h2 id="chat-g-bt-heading"
                            class="font-mono text-3xl font-bold text-zinc-950 transition-colors group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-200 md:text-5xl">
                            Chat G B.T.
                        </h2>
                        <p class="mt-2 font-mono text-sm font-semibold text-cyan-700 dark:text-cyan-300">
                            The Original Chat G
                        </p>
                        <p class="mt-4 max-w-2xl text-zinc-700 dark:text-zinc-300 leading-relaxed">
                            Original posts from B.T. Franklin, with ideas, observations, and a little old-school flavor.
                        </p>
                    </div>
                    <span
                        class="w-fit shrink-0 rounded-md border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 font-mono text-sm font-bold text-cyan-800 transition-colors group-hover:bg-cyan-500/20 dark:text-cyan-200">
                        Enter the blog →
                    </span>
                </div>
            </a>
        </section>

        <section class="mt-14" aria-labelledby="articles-heading">
            <div class="mb-6">
                <h2 id="articles-heading" class="font-mono text-2xl font-bold text-zinc-900 dark:text-zinc-100 md:text-3xl">
                    Articles
                </h2>
                <p class="mt-2 max-w-2xl text-zinc-600 dark:text-zinc-400 leading-relaxed">
                    Longer-form essays and reflections that stand on their own.
                </p>
            </div>

            <div class="space-y-6">
                {% for piece in collections.articles %}
                <a href="{{ piece.url }}"
                    class="group block rounded-lg border border-violet-300/70 bg-white/85 p-6 shadow-lg backdrop-blur-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-2xl dark:border-violet-700/60 dark:bg-violet-950/30 md:p-8">
                    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                        <h3
                            class="font-mono text-2xl font-bold text-zinc-950 transition-colors group-hover:text-violet-600 dark:text-white dark:group-hover:text-violet-300 md:text-3xl">
                            {{ piece.data.title }}
                        </h3>
                        {% if piece.date %}
                        <time class="shrink-0 font-mono text-sm text-zinc-500 dark:text-zinc-400"
                            datetime="{{ piece.date.toISOString() }}">{{ piece.date | displayDate }}</time>
                        {% endif %}
                    </div>
                    {% if piece.data.description %}
                    <p class="mt-4 text-zinc-700 dark:text-zinc-300 leading-relaxed">
                        {{ piece.data.description }}
                    </p>
                    {% endif %}
                </a>
                {% endfor %}
            </div>
        </section>
    </div>
</main>
